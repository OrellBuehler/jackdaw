    {"input": "```py\nx = {{1}}", "blocks": [["t", [["l", "```py\nx = "], ["g", {"answers": ["1"], "hint": null}]]]], "note": "no closing fence: not a block, the gap is a gap of the text"},
    {"input": "```\n{{a}}\n```\n```\n{{b}}\n```", "blocks": [["c", null, [["g", {"answers": ["a"], "hint": null}]]], ["c", null, [["g", {"answers": ["b"], "hint": null}]]]], "note": "two blocks"}
