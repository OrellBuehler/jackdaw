{
  "description": "Conformance vectors for the Jackdaw pack format, versions 1 to 3. A reader must reproduce every 'expected', 'result', 'spans', 'segments', 'valid' and 'aspectRatio' value. See README.md sections 'Text markup', 'Cloze gaps', 'Figures', 'Maps' and 'Answer matching'. 'normalize' is the answer normal form; 'match' compares a typed answer with an accepted answer; 'markup' is the rich text tokenizer (style '' = plain, b = bold, i = italic, c = code); 'cloze' splits cloze text into raw rich-text segments (t) and parsed gaps (g). 'figure' says whether a reader accepts the SVG of a figure and, if so, the width divided by the height of its viewBox. 'map' gives the value of a map property (any JSON) and what a reader makes of it: 'expected' is null when the whole property is ignored, otherwise the pins that stay as [lat, lng, label or null] in their order (at most 20, invalid ones dropped), 'line' and 'alt' (null when absent or ignored). Flags that are not listed are false.",
  "normalize": [
    {"input": "Hello", "expected": "hello", "note": "case-insensitive by default"},
    {"input": "Na", "expected": "Na", "caseSensitive": true, "note": "caseSensitive keeps case"},
    {"input": "  Hello,   World!  ", "expected": "hello, world", "note": "trim, collapse whitespace, strip trailing punctuation"},
    {"input": "Hello\tWorld\n", "expected": "hello world", "note": "tabs and newlines are whitespace"},
    {"input": "Hello\u00a0World", "expected": "hello world", "note": "no-break space is whitespace"},
    {"input": "Hello\u3000World", "expected": "hello world", "note": "ideographic space is whitespace"},
    {"input": "Hello\r\nWorld", "expected": "hello world"},
    {"input": "a\u200bb", "expected": "a\u200bb", "note": "zero width space is NOT whitespace and is kept"},
    {"input": "¿Cómo estás?", "expected": "cómo estás", "note": "leading inverted question mark and trailing question mark are stripped"},
    {"input": "¡Hola!", "expected": "hola"},
    {"input": "What?!", "expected": "what", "note": "all trailing punctuation is stripped"},
    {"input": "Hello .", "expected": "hello", "note": "spaces between the text and the punctuation are trimmed too"},
    {"input": "a , .", "expected": "a"},
    {"input": "U.S.A.", "expected": "u.s.a", "note": "only the END is stripped"},
    {"input": "?!", "expected": "?!", "note": "a string that consists only of punctuation is kept as is"},
    {"input": "…", "expected": "…"},
    {"input": "ありがとう。", "expected": "ありがとう", "note": "ideographic full stop is stripped"},
    {"input": "   ", "expected": "", "note": "whitespace only normalises to the empty string"},
    {"input": "don’t", "expected": "don't", "note": "typographic apostrophe is unified"},
    {"input": "“quoted”", "expected": "\"quoted\"", "note": "typographic quotes are unified, not stripped"},
    {"input": "2000–2005", "expected": "2000-2005", "note": "en dash is unified with hyphen-minus"},
    {"input": "x-", "expected": "x-", "note": "a trailing hyphen is not punctuation to strip"},
    {"input": "(ser)", "expected": "(ser)", "note": "brackets are not stripped"},
    {"input": "Zürich", "expected": "zürich", "note": "diacritics are significant by default"},
    {"input": "Zürich", "expected": "zurich", "ignoreDiacritics": true, "note": "ignoreDiacritics removes combining marks"},
    {"input": "Zu\u0308rich", "expected": "zürich", "note": "decomposed input is normalised to NFC"},
    {"input": "Zu\u0308rich", "expected": "zurich", "ignoreDiacritics": true, "note": "decomposed input with ignoreDiacritics"},
    {"input": "e\u0301", "expected": "é", "note": "NFC composition"},
    {"input": "ÅNGSTRÖM", "expected": "angstrom", "ignoreDiacritics": true, "note": "ignoreDiacritics"},
    {"input": "ø", "expected": "ø", "ignoreDiacritics": true, "note": "letters without a decomposition are kept even with ignoreDiacritics"},
    {"input": "Łódź", "expected": "łodz", "ignoreDiacritics": true, "note": "only the combining marks of the letters that decompose are removed"},
    {"input": "STRASSE", "expected": "strasse", "note": "no full case folding"},
    {"input": "Straße", "expected": "straße", "note": "sharp s is kept"},
    {"input": "ÜBER", "expected": "über", "note": "lowercasing applies to non-ASCII letters"},
    {"input": "Señor", "expected": "senor", "ignoreDiacritics": true, "note": "tilde on n is a combining mark"}
  ],
  "match": [
    {"typed": "zurich", "expected": "Zürich", "result": true, "ignoreDiacritics": true},
    {"typed": "zurich", "expected": "Zürich", "result": false},
    {"typed": "Zürich", "expected": "Zürich", "result": true},
    {"typed": "Paris.", "expected": "paris", "result": true},
    {"typed": "paris", "expected": "Paris", "result": false, "caseSensitive": true},
    {"typed": "Paris", "expected": "Paris", "result": true, "caseSensitive": true},
    {"typed": "colour", "expected": "color", "result": false},
    {"typed": "I’m sorry", "expected": "I'm sorry", "result": true},
    {"typed": "the   cat", "expected": "The cat", "result": true},
    {"typed": "cat!", "expected": "cat?", "result": true},
    {"typed": "3", "expected": "three", "result": false},
    {"typed": "", "expected": "answer", "result": false},
    {"typed": "how are you", "expected": "¿cómo estás?", "result": false},
    {"typed": "como estas", "expected": "¿cómo estás?", "result": true, "ignoreDiacritics": true}
  ],
  "markup": [
    {"input": "plain", "spans": [["", "plain"]], "plain": "plain"},
    {"input": "**bold**", "spans": [["b", "bold"]], "plain": "bold"},
    {"input": "*italic*", "spans": [["i", "italic"]], "plain": "italic"},
    {"input": "`code`", "spans": [["c", "code"]], "plain": "code"},
    {"input": "a **b** c *d* e `f`", "spans": [["", "a "], ["b", "b"], ["", " c "], ["i", "d"], ["", " e "], ["c", "f"]], "plain": "a b c d e f"},
    {"input": "**bold**text", "spans": [["b", "bold"], ["", "text"]], "plain": "boldtext"},
    {"input": "5 * 3 * 2", "spans": [["", "5 * 3 * 2"]], "plain": "5 * 3 * 2", "note": "a marker followed or preceded by whitespace is literal"},
    {"input": "2*3*4", "spans": [["", "2"], ["i", "3"], ["", "4"]], "plain": "234", "note": "no whitespace: this IS italic; escape the asterisks (2\\*3\\*4) to keep them"},
    {"input": "2\\*3\\*4", "spans": [["", "2*3*4"]], "plain": "2*3*4"},
    {"input": "\\*not italic\\*", "spans": [["", "*not italic*"]], "plain": "*not italic*"},
    {"input": "\\`not code\\`", "spans": [["", "`not code`"]], "plain": "`not code`"},
    {"input": "C:\\Users", "spans": [["", "C:\\Users"]], "plain": "C:\\Users", "note": "a backslash before a character that is not escapable stays"},
    {"input": "back\\\\slash", "spans": [["", "back\\slash"]], "plain": "back\\slash", "note": "two backslashes become one"},
    {"input": "\\{\\}\\|\\:", "spans": [["", "{}|:"]], "plain": "{}|:", "note": "all seven characters can be escaped, in every rich text field"},
    {"input": "**a *b* c**", "spans": [["b", "a *b* c"]], "plain": "a *b* c", "note": "no nesting: markers inside a span are literal"},
    {"input": "**unclosed", "spans": [["", "**unclosed"]], "plain": "**unclosed"},
    {"input": "*unclosed", "spans": [["", "*unclosed"]], "plain": "*unclosed"},
    {"input": "* spaced *", "spans": [["", "* spaced *"]], "plain": "* spaced *"},
    {"input": "**bold ** x", "spans": [["", "**bold ** x"]], "plain": "**bold ** x", "note": "a closing marker must not be preceded by whitespace"},
    {"input": "`a*b*c`", "spans": [["c", "a*b*c"]], "plain": "a*b*c", "note": "code content is literal"},
    {"input": "`\\*`", "spans": [["c", "\\*"]], "plain": "\\*", "note": "escapes are not processed inside code"},
    {"input": "``", "spans": [["", "``"]], "plain": "``", "note": "empty code span is literal"},
    {"input": "***x***", "spans": [["b", "*x"], ["", "*"]], "plain": "*x*", "note": "triple asterisks are not supported; avoid them"},
    {"input": "line1\nline2", "spans": [["", "line1\nline2"]], "plain": "line1\nline2", "note": "newlines are kept"},
    {"input": "*a\nb*", "spans": [["", "*a\nb*"]], "plain": "*a\nb*", "note": "spans never cross a newline"},
    {"input": "{{not a gap}} outside cloze", "spans": [["", "{{not a gap}} outside cloze"]], "plain": "{{not a gap}} outside cloze", "note": "braces mean nothing outside cloze text"},
    {"input": "<b>no html</b> &amp; [no](links)", "spans": [["", "<b>no html</b> &amp; [no](links)"]], "plain": "<b>no html</b> &amp; [no](links)"}
  ],
  "cloze": [
    {"input": "The capital is {{Paris}}.", "segments": [["t", "The capital is "], ["g", {"answers": ["Paris"], "hint": null}], ["t", "."]]},
    {"input": "{{a|b}}", "segments": [["g", {"answers": ["a", "b"], "hint": null}]], "note": "alternatives; the first one is canonical"},
    {"input": "{{colour|color::British or US}}", "segments": [["g", {"answers": ["colour", "color"], "hint": "British or US"}]]},
    {"input": "{{ Paris }}", "segments": [["g", {"answers": ["Paris"], "hint": null}]], "note": "answers and hints are trimmed"},
    {"input": "{{|a|}}", "segments": [["g", {"answers": ["a"], "hint": null}]], "note": "empty alternatives are dropped"},
    {"input": "{{a}} and {{b::hint}}", "segments": [["g", {"answers": ["a"], "hint": null}], ["t", " and "], ["g", {"answers": ["b"], "hint": "hint"}]]},
    {"input": "{{a::b::c}}", "segments": [["g", {"answers": ["a"], "hint": "b::c"}]], "note": "only the first :: separates the hint"},
    {"input": "{{a\\|b}}", "segments": [["g", {"answers": ["a|b"], "hint": null}]], "note": "escaped | is part of the answer"},
    {"input": "{{a\\::b}}", "segments": [["g", {"answers": ["a::b"], "hint": null}]], "note": "\\: is a literal colon, so there is no hint separator here"},
    {"input": "{{a\\}b}}", "segments": [["g", {"answers": ["a}b"], "hint": null}]], "note": "\\} is a literal brace inside an answer"},
    {"input": "{{a\\}}}", "segments": [["g", {"answers": ["a}"], "hint": null}]], "note": "an escaped brace directly before the closing braces"},
    {"input": "{{}}", "segments": [["t", "{{}}"]], "note": "a gap without an answer is not a gap"},
    {"input": "{{ }}", "segments": [["t", "{{ }}"]]},
    {"input": "{{::only a hint}}", "segments": [["t", "{{::only a hint}}"]]},
    {"input": "\\{{x}}", "segments": [["t", "\\{{x}}"]], "note": "an escaped brace prevents the gap; the raw text (with the backslash) is passed on to the markup parser"},
    {"input": "unterminated {{gap", "segments": [["t", "unterminated {{gap"]]},
    {"input": "{{multi\nline}}", "segments": [["t", "{{multi\nline}}"]], "note": "a gap must not contain a newline"},
    {"input": "**{{x}}**", "segments": [["t", "**"], ["g", {"answers": ["x"], "hint": null}], ["t", "**"]], "note": "markup spans never cross a gap"},
    {"input": "no gaps at all", "segments": [["t", "no gaps at all"]]}
  ],
  "figure": [
    {"svg": "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 100'><circle cx='50' cy='50' r='40'/></svg>", "valid": true, "aspectRatio": 2.0, "note": "minimal figure"},
    {"svg": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg viewBox=\"0 0 30 40\"></svg>", "valid": true, "aspectRatio": 0.75, "note": "a leading XML declaration is tolerated"},
    {"svg": "  <!-- drawn by hand -->\n<svg viewBox=\"0,0,100,50\"><title>Two</title></svg>\n", "valid": true, "aspectRatio": 2.0, "note": "comments, surrounding whitespace, commas in viewBox"},
    {"svg": "<svg viewBox='-10 -10 1e2 .5e2' width='10' height='999'/>", "valid": true, "aspectRatio": 2.0, "note": "width and height attributes are ignored, numbers may use exponents"},
    {"svg": "<svg viewBox='0 0 10 10'><style>@keyframes spin{to{transform:rotate(360deg)}} .a{animation:spin 2s linear infinite;fill:currentColor}</style><rect class='a' width='4' height='4'/></svg>", "valid": true, "aspectRatio": 1.0, "note": "CSS animation"},
    {"svg": "<svg viewBox='0 0 10 10'><circle r='2'><animate attributeName='cx' from='0' to='10' dur='2s' repeatCount='indefinite'/></circle></svg>", "valid": true, "aspectRatio": 1.0, "note": "SMIL animation"},
    {"svg": "<svg viewBox='0 0 10 10' xmlns:xlink='http://www.w3.org/1999/xlink'><defs><linearGradient id='g'><stop offset='0'/></linearGradient><path id='p' d='M0 0h10'/></defs><rect fill='url(#g)' width='10' height='10'/><use href='#p'/><use xlink:href = \"#p\"/><circle r='1'><animateMotion dur='3s'><mpath href='#p'/></animateMotion></circle></svg>", "valid": true, "aspectRatio": 1.0, "note": "references inside the figure"},
    {"svg": "<svg viewBox='0 0 10 10'><style><![CDATA[ .a{fill:url( '#g' )} ]]></style><text x='1' y='5'>1 &lt; 2, on = off</text></svg>", "valid": true, "aspectRatio": 1.0, "note": "CDATA, escaped '<', the word 'on' without a name before '='"},
    {"svg": "<svg viewBox='0 0 10 10'><g data-icon='x' font-family='sans-serif'/></svg>", "valid": true, "aspectRatio": 1.0, "note": "attribute names that merely contain 'on'"},
    {"svg": "<svg><circle r='4'/></svg>", "valid": false, "note": "no viewBox"},
    {"svg": "<svg viewbox='0 0 10 10'/>", "valid": false, "note": "viewBox is case-sensitive"},
    {"svg": "<svg viewBox='0 0 10'/>", "valid": false, "note": "three numbers"},
    {"svg": "<svg viewBox='0 0 0 10'/>", "valid": false, "note": "zero width"},
    {"svg": "<svg viewBox='0 0 10 -5'/>", "valid": false, "note": "negative height"},
    {"svg": "<svg viewBox='0 0 10px 10px'/>", "valid": false, "note": "units"},
    {"svg": "<svg viewBox='0 0 Infinity 10'/>", "valid": false, "note": "not a number"},
    {"svg": "<svg viewBox=0 0 10 10/>", "valid": false, "note": "unquoted viewBox"},
    {"svg": "<g viewBox='0 0 10 10'/>", "valid": false, "note": "root is not svg"},
    {"svg": "circle", "valid": false, "note": "no element at all"},
    {"svg": "</svg><svg viewBox='0 0 10 10'/>", "valid": false, "note": "starts with a closing tag"},
    {"svg": "<svg viewBox='0 0 10 10'", "valid": false, "note": "root tag never closes"},
    {"svg": "<svg viewBox='0 0 10 10'><script>alert(1)</script></svg>", "valid": false, "note": "script"},
    {"svg": "<svg viewBox='0 0 10 10'><SCRIPT>alert(1)</SCRIPT></svg>", "valid": false, "note": "element names are case-sensitive, anything unknown is rejected"},
    {"svg": "<svg viewBox='0 0 10 10'><foreignObject><p>hi</p></foreignObject></svg>", "valid": false, "note": "foreignObject"},
    {"svg": "<svg viewBox='0 0 10 10'><image href='#a'/></svg>", "valid": false, "note": "image"},
    {"svg": "<svg viewBox='0 0 10 10'><a href='#x'><circle r='1'/></a></svg>", "valid": false, "note": "links"},
    {"svg": "<svg viewBox='0 0 10 10'><!-- <b>x</b> --></svg>", "valid": false, "note": "element names are checked inside comments too"},
    {"svg": "<svg viewBox='0 0 10 10'><text>1 < 2</text></svg>", "valid": false, "note": "a bare '<' in text"},
    {"svg": "<svg viewBox='0 0 10 10' onload='x()'/>", "valid": false, "note": "event handler"},
    {"svg": "<svg viewBox='0 0 10 10'><rect ONCLICK = 'x()'/></svg>", "valid": false, "note": "event handler, upper case and spaced"},
    {"svg": "<svg viewBox='0 0 10 10'><rect width='1'onmouseover='x()'/></svg>", "valid": false, "note": "event handler directly after a quote"},
    {"svg": "<svg viewBox='0 0 10 10'><use href='https://example.com/a.svg#b'/></svg>", "valid": false, "note": "external href"},
    {"svg": "<svg viewBox='0 0 10 10'><use xlink:href=\"data:image/svg+xml,x\"/></svg>", "valid": false, "note": "data href"},
    {"svg": "<svg viewBox='0 0 10 10'><use href=#p/></svg>", "valid": false, "note": "unquoted href"},
    {"svg": "<svg viewBox='0 0 10 10'><rect fill='url(https://example.com/g.svg#g)'/></svg>", "valid": false, "note": "external url()"},
    {"svg": "<svg viewBox='0 0 10 10'><style>.a{background:URL( \"//example.com/x.png\" )}</style></svg>", "valid": false, "note": "external url() in CSS"},
    {"svg": "<svg viewBox='0 0 10 10'><style>@import 'https://example.com/a.css';</style></svg>", "valid": false, "note": "@import"},
    {"svg": "<svg viewBox='0 0 10 10'><set attributeName='href' to='javascript:alert(1)'/></svg>", "valid": false, "note": "javascript:"},
    {"svg": "<!DOCTYPE svg [<!ENTITY a 'b'>]><svg viewBox='0 0 10 10'/>", "valid": false, "note": "DOCTYPE and entities"},
    {"svg": "<svg viewBox='0 0 10 10'><?xml-stylesheet href='#a'?></svg>", "valid": false, "note": "processing instruction"},
    {"svg": "<?xml version='1.0'<svg viewBox='0 0 10 10'/>", "valid": false, "note": "unterminated XML declaration"}
  ],
  "map": [
    {"input": {"pins": [{"lat": 48.8566, "lng": 2.3522}]}, "expected": {"pins": [[48.8566, 2.3522, null]], "line": false, "alt": null}, "note": "minimal map: one pin"},
    {"input": {"pins": [{"lat": 48.8566, "lng": 2.3522, "label": "Paris"}, {"lat": -33.8688, "lng": 151.2093, "label": "Sydney"}], "line": true, "alt": "Paris and Sydney."}, "expected": {"pins": [[48.8566, 2.3522, "Paris"], [-33.8688, 151.2093, "Sydney"]], "line": true, "alt": "Paris and Sydney."}, "note": "labels, line and alt"},
    {"input": {"pins": [{"lat": 90, "lng": 180}, {"lat": -90, "lng": -180}, {"lat": 0, "lng": 0}]}, "expected": {"pins": [[90.0, 180.0, null], [-90.0, -180.0, null], [0.0, 0.0, null]], "line": false, "alt": null}, "note": "the limits are valid"},
    {"input": {"pins": [{"lat": 90.0001, "lng": 0}]}, "expected": null, "note": "latitude above 90: the only pin is dropped, so the map is ignored"},
    {"input": {"pins": [{"lat": -90.5, "lng": 0}]}, "expected": null, "note": "latitude below -90"},
    {"input": {"pins": [{"lat": 10, "lng": 180.5}, {"lat": 11, "lng": 12}]}, "expected": {"pins": [[11.0, 12.0, null]], "line": false, "alt": null}, "note": "longitude above 180: that pin is dropped, the other stays"},
    {"input": {"pins": [{"lat": 10, "lng": -181}]}, "expected": null, "note": "longitude below -180"},
    {"input": {"pins": [{"lat": "48.8", "lng": "2.3"}]}, "expected": null, "note": "coordinates as strings are not numbers"},
    {"input": {"pins": [{"lat": true, "lng": 1}]}, "expected": null, "note": "a boolean is not a number"},
    {"input": {"pins": [{"lat": null, "lng": 1}, {"lat": 1}]}, "expected": null, "note": "null and missing coordinates"},
    {"input": {"pins": [5, "x", [1, 2], null, {"lat": 1, "lng": 2}]}, "expected": {"pins": [[1.0, 2.0, null]], "line": false, "alt": null}, "note": "entries that are not objects are dropped"},
    {"input": {"pins": [{"lat": 48.8, "lng": 0, "label": "x"}, {"lat": 10.0, "lng": 2}]}, "expected": {"pins": [[48.8, 0.0, "x"], [10.0, 2.0, null]], "line": false, "alt": null}, "note": "exponent notation and negative zero"},
    {"input": {"pins": [{"lat": Infinity, "lng": 0}]}, "expected": null, "note": "a number that overflows is not finite"},
    {"input": {"pins": [{"lat": 100.0, "lng": 0}]}, "expected": null, "note": "1e2 is 100, out of range"},
    {"input": {"pins": []}, "expected": null, "note": "no pins"},
    {"input": {"pins": {"lat": 1, "lng": 2}}, "expected": null, "note": "pins must be an array"},
    {"input": {"lat": 1, "lng": 2}, "expected": null, "note": "no pins property"},
    {"input": "Paris", "expected": null, "note": "a map must be an object"},
    {"input": [{"lat": 1, "lng": 2}], "expected": null, "note": "an array is not a map"},
    {"input": null, "expected": null, "note": "null is not a map"},
    {"input": {"pins": [{"lat": 1, "lng": 2}], "line": "yes"}, "expected": {"pins": [[1.0, 2.0, null]], "line": false, "alt": null}, "note": "a line that is not a boolean is ignored"},
    {"input": {"pins": [{"lat": 1, "lng": 2}, {"lat": 3, "lng": 4}], "line": true}, "expected": {"pins": [[1.0, 2.0, null], [3.0, 4.0, null]], "line": true, "alt": null}, "note": "line"},
    {"input": {"pins": [{"lat": 1, "lng": 2}], "alt": 7}, "expected": {"pins": [[1.0, 2.0, null]], "line": false, "alt": null}, "note": "alt that is not a string is ignored"},
    {"input": {"pins": [{"lat": 1, "lng": 2}], "alt": " \t "}, "expected": {"pins": [[1.0, 2.0, null]], "line": false, "alt": null}, "note": "a blank alt is ignored"},
    {"input": {"pins": [{"lat": 1, "lng": 2, "label": 7}, {"lat": 3, "lng": 4, "label": "  "}, {"lat": 5, "lng": 6, "label": " Rome "}]}, "expected": {"pins": [[1.0, 2.0, null], [3.0, 4.0, null], [5.0, 6.0, " Rome "]], "line": false, "alt": null}, "note": "a label that is not a string or is blank is ignored, the pin stays; labels are kept as written"},
    {"input": {"pins": [{"lat": 0, "lng": 0}, {"lat": 1, "lng": 1}, {"lat": 2, "lng": 2}, {"lat": 3, "lng": 3}, {"lat": 4, "lng": 4}, {"lat": 5, "lng": 5}, {"lat": 6, "lng": 6}, {"lat": 7, "lng": 7}, {"lat": 8, "lng": 8}, {"lat": 9, "lng": 9}, {"lat": 10, "lng": 10}, {"lat": 11, "lng": 11}, {"lat": 12, "lng": 12}, {"lat": 13, "lng": 13}, {"lat": 14, "lng": 14}, {"lat": 15, "lng": 15}, {"lat": 16, "lng": 16}, {"lat": 17, "lng": 17}, {"lat": 18, "lng": 18}, {"lat": 19, "lng": 19}, {"lat": 20, "lng": 20}]}, "expected": {"pins": [[0.0, 0.0, null], [1.0, 1.0, null], [2.0, 2.0, null], [3.0, 3.0, null], [4.0, 4.0, null], [5.0, 5.0, null], [6.0, 6.0, null], [7.0, 7.0, null], [8.0, 8.0, null], [9.0, 9.0, null], [10.0, 10.0, null], [11.0, 11.0, null], [12.0, 12.0, null], [13.0, 13.0, null], [14.0, 14.0, null], [15.0, 15.0, null], [16.0, 16.0, null], [17.0, 17.0, null], [18.0, 18.0, null], [19.0, 19.0, null]], "line": false, "alt": null}, "note": "21 pins: only the first 20 are used"},
    {"input": {"pins": [{"lat": 1, "lng": 2}, {"lat": 999, "lng": 0}, {"lat": 3, "lng": 4}]}, "expected": {"pins": [[1.0, 2.0, null], [3.0, 4.0, null]], "line": false, "alt": null}, "note": "invalid pins in between are dropped, the order of the others stays"},
    {"input": {"pins": [{"lat": 1, "lng": 2}], "zoom": 5, "x-tool": {"a": 1}}, "expected": {"pins": [[1.0, 2.0, null]], "line": false, "alt": null}, "note": "unknown properties are ignored"},
    {"input": {"pins": [{"lat": 35.68, "lng": 139.65, "label": "Tokyo"}, {"lat": 21.3, "lng": -157.86, "label": "Honolulu"}]}, "expected": {"pins": [[35.68, 139.65, "Tokyo"], [21.3, -157.86, "Honolulu"]], "line": false, "alt": null}, "note": "pins on both sides of the 180th meridian are fine"}
  ]
}
