    {
      "id": "istanbul",
      "type": "truefalse",
      "section": "facts",
      "statement": "Istanbul is the capital of Turkey.",
      "answer": false,
      "explanation": "The capital is Ankara. Istanbul is the largest city."
    },
    {
      "id": "the-hague",
      "type": "truefalse",
      "section": "facts",
      "statement": "The Dutch government sits in Amsterdam.",
      "answer": false,
      "explanation": "Amsterdam is the capital, but government, parliament and the royal working palace are in The Hague."
    },
    {
      "id": "non-eu-capital",
      "type": "choice",
      "section": "facts",
      "question": "Which of these capitals is **not** in a member state of the European Union?",
      "options": [
        {"text": "Dublin", "explanation": "Ireland joined in 1973."},
        {"text": "Helsinki", "explanation": "Finland joined in 1995."},
        {"text": "Oslo", "correct": true, "explanation": "Norway is not an EU member. It is part of the European Economic Area."},
        {"text": "Zagreb", "explanation": "Croatia joined in 2013."}
      ]
    },
    {
      "id": "smallest-state",
      "type": "choice",
      "section": "facts",
      "question": "Which is the smallest sovereign state in Europe, and in the world?",
      "options": [
        {"text": "San Marino", "explanation": "About 61 square kilometres."},
        {"text": "Monaco", "explanation": "The second smallest, about 2 square kilometres."},
        {"text": "Vatican City", "correct": true, "explanation": "About 0.44 square kilometres, entirely surrounded by Rome."},
        {"text": "Liechtenstein", "explanation": "About 160 square kilometres."}
      ]
    },
    {
      "id": "buda-pest",
      "type": "text",
      "section": "facts",
      "question": "Which capital was formed in 1873 by merging the towns of Buda, Óbuda and Pest?",
      "answers": ["Budapest"]
    },
    {
      "id": "danube-capitals",
      "type": "cloze",
      "section": "facts",
      "text": "Going downstream, the Danube flows through four capitals: Vienna, Bratislava, {{Budapest}} and {{Belgrade}}.",
      "explanation": "No other river in the world flows through as many capitals."
    },
    {
      "id": "north-to-south",
      "type": "order",
      "section": "facts",
      "prompt": "Order these capitals from north to south.",
      "sequence": ["Reykjavik", "Stockholm", "Copenhagen", "Berlin", "Paris", "Rome", "Athens"],
      "explanation": "Their latitudes are about 64°, 59°, 56°, 52.5°, 49°, 42° and 38° north."
    }
