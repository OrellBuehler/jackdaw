{
  "$schema": "https://raw.githubusercontent.com/OrellBuehler/jackdaw/main/format/jackdaw-pack.schema.json",
  "format": "jackdaw-pack",
  "version": 1,
  "id": "com.github.orellbuehler.jackdaw.examples.european-capitals",
  "title": "European Capitals",
  "description": "The capitals of 45 European countries, region by region, followed by a few questions that go beyond the list. Cards are asked as multiple choice and as typed answers; local spellings such as Wien or Praha are accepted.",
  "language": "en",
  "author": "Jackdaw project",
  "license": "CC0-1.0",
  "source": "https://github.com/OrellBuehler/jackdaw",
  "tags": ["geography", "europe", "capitals"],
  "icon": "🏛️",
  "color": "#1E40AF",
  "revision": 1,
  "created": "2026-11-21",
  "updated": "2026-11-21",
  "sections": [
    {"id": "west", "title": "Western and Central Europe"},
    {"id": "north", "title": "Northern Europe and the Baltics"},
    {"id": "south", "title": "Southern Europe"},
    {"id": "east", "title": "Eastern Europe"},
    {"id": "balkans", "title": "The Balkans"},
    {"id": "facts", "title": "Beyond the list", "description": "Seats of government, rivers and a little sorting."}
  ],
  "study": {"order": "sequential", "newPerSession": 8, "ignoreDiacritics": true, "exercises": {"card": ["choice", "type"]}},
  "items": [
    {"id": "capital-france", "type": "card", "section": "west", "front": "Capital of **France**?", "back": "Paris"},
    {
      "id": "capital-belgium",
      "type": "card",
      "section": "west",
      "front": "Capital of **Belgium**?",
      "back": "Brussels",
      "alternatives": ["Bruxelles", "Brussel"],
      "explanation": "Brussels also hosts the main institutions of the European Union."
    },
    {
      "id": "capital-netherlands",
      "type": "card",
      "section": "west",
      "front": "Capital of **Netherlands**?",
      "back": "Amsterdam",
      "explanation": "Amsterdam is the capital by constitution, but government and parliament sit in The Hague."
    },
    {
      "id": "capital-luxembourg",
      "type": "card",
      "section": "west",
      "front": "Capital of **Luxembourg**?",
      "back": "Luxembourg",
      "alternatives": ["Luxembourg City"]
    },
    {
      "id": "capital-germany",
      "type": "card",
      "section": "west",
      "front": "Capital of **Germany**?",
      "back": "Berlin",
      "explanation": "Berlin has been the capital of reunified Germany since 1990. West Germany was governed from Bonn."
    },
    {
      "id": "capital-austria",
      "type": "card",
      "section": "west",
      "front": "Capital of **Austria**?",
      "back": "Vienna",
      "alternatives": ["Wien"]
    },
    {
      "id": "capital-switzerland",
      "type": "card",
      "section": "west",
      "front": "Capital of **Switzerland**?",
      "back": "Bern",
      "alternatives": ["Berne"],
      "explanation": "Bern is the seat of government and parliament. The constitution names no capital, so it is officially the *federal city*."
    },
    {"id": "capital-liechtenstein", "type": "card", "section": "west", "front": "Capital of **Liechtenstein**?", "back": "Vaduz"},
    {"id": "capital-united-kingdom", "type": "card", "section": "west", "front": "Capital of **United Kingdom**?", "back": "London"},
    {"id": "capital-ireland", "type": "card", "section": "west", "front": "Capital of **Ireland**?", "back": "Dublin"},
    {
      "id": "capital-monaco",
      "type": "card",
      "section": "west",
      "front": "Capital of **Monaco**?",
      "back": "Monaco",
      "explanation": "Monaco is a city-state: the country and its capital are the same."
    },
    {
      "id": "capital-iceland",
      "type": "card",
      "section": "north",
      "front": "Capital of **Iceland**?",
      "back": "Reykjavik",
