  "version": 3,
  "id": "com.github.orellbuehler.jackdaw.examples.rivers-on-the-map",
  "title": "Rivers on the Map",
  "description": "78 of the world's great rivers, by continent. A line on the map joins the source to the mouth: name the river, with alternative spellings such as Rhein, Donau or Tajo accepted. The explanation gives the countries and the length, and a last chapter asks into which sea 30 of them flow.",
  "language": "en",
  "author": "Jackdaw project",
  "license": "CC0-1.0",
  "source": "https://www.wikidata.org",
  "tags": [
    "geography",
    "maps",
    "rivers",
    "world"
  ],
  "icon": "🏞️",
  "color": "#0369A1",
  "revision": 1,
  "created": "2026-11-25",
  "updated": "2026-11-25",
  "sections": [
    {
      "id": "europe-west",
      "title": "Western and Southern Europe",
      "description": "From the Alps and the Pyrenees to the Thames and the Shannon."
    },
    {
      "id": "europe-east",
      "title": "Central, Northern and Eastern Europe",
      "description": "From the Danube and the Elbe to the Volga."
    },
    {
      "id": "siberia",
      "title": "Siberia and the Russian Far East",
      "description": "The great rivers that flow north and east across Russia."
    },
    {
      "id": "asia-east",
      "title": "East and Southeast Asia",
      "description": "From the Tibetan Plateau to the Pacific."
    },
    {
      "id": "asia-south",
      "title": "South and West Asia",
      "description": "Rivers of the Indian subcontinent and the Middle East."
    },
    {
      "id": "africa",
      "title": "Africa",
      "description": "The Nile and five more."
    },
    {
      "id": "north-america",
      "title": "North America",
      "description": "From the Rockies to the Atlantic, the Pacific and the Arctic."
    },
    {
      "id": "south-america",
      "title": "South America",
      "description": "The Amazon and its neighbours."
    },
    {
      "id": "oceania",
      "title": "Australia and New Zealand",
      "description": "The longest rivers of Australia and New Zealand."
    },
    {
      "id": "seas",
      "title": "Where do they end?",
      "description": "Name the sea, gulf or ocean at the mouth."
    }
  ],
  "study": {
    "order": "sequential",
    "newPerSession": 8,
    "ignoreDiacritics": true,
    "exercises": {
      "card": [
        "flip",
        "choice",
        "type"
      ]
    }
  },
