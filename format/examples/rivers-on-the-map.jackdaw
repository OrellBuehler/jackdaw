      "id": "rhine",
      "type": "card",
      "section": "europe-west",
      "front": "Which river rises at the first pin and flows to the second?",
      "back": "Rhine",
      "alternatives": [
        "Rhein",
        "River Rhine",
        "The Rhine",
        "Rhin"
      ],
      "hint": "A river in Europe.",
      "explanation": "It rises from Lake Toma in the Swiss Alps and ends in the North Sea near Rotterdam. It flows through Switzerland, Liechtenstein, Austria, Germany, France and the Netherlands and is about 1,230 km long.",
