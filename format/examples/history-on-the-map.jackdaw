  "version": 3,
  "id": "com.github.orellbuehler.jackdaw.examples.history-on-the-map",
  "title": "History on the Map",
  "description": "124 turning points of world history, from the Battle of Marathon to the 2008 Sichuan earthquake. You see a pin on the world map and a year and name the event; after the answer the map shows the place. Mostly multiple choice, with typed answers for the shorter names, and a last chapter of 31 questions that asks where it happened.",
  "language": "en",
  "author": "Jackdaw project",
  "license": "CC0-1.0",
  "source": "https://www.wikidata.org",
  "tags": [
    "history",
    "geography",
    "maps",
    "events",
    "world"
  ],
  "icon": "📍",
  "color": "#B45309",
  "revision": 1,
  "created": "2026-11-25",
  "updated": "2026-11-25",
  "sections": [
    {
      "id": "antiquity",
      "title": "Antiquity",
      "description": "From the Bronze Age to the fall of Rome."
    },
    {
      "id": "middle-ages",
      "title": "The Middle Ages",
      "description": "From 500 to 1500."
    },
    {
      "id": "early-modern",
      "title": "The early modern world",
      "description": "From 1500 to 1800: empires, voyages and revolutions."
    },
    {
      "id": "nineteenth",
      "title": "Revolutions and empires",
      "description": "From 1800 to 1899."
    },
    {
      "id": "ww1",
      "title": "1900 to 1918",
      "description": "Empires at war and a world in revolt."
    },
    {
      "id": "interwar",
      "title": "Between the wars",
      "description": "From 1919 to 1938."
    },
    {
      "id": "ww2",
      "title": "The Second World War",
      "description": "From 1939 to 1945."
    },
    {
      "id": "postwar",
      "title": "Since 1946",
      "description": "From the end of the Second World War to today."
    },
    {
      "id": "where",
      "title": "Where did it happen?",
      "description": "The same events seen from the other side: name the city, country or region."
    }
  ],
  "study": {
    "order": "sequential",
    "newPerSession": 6,
    "ignoreDiacritics": true,
    "exercises": {
      "card": [
        "flip",
        "choice"
      ]
    }
  },
