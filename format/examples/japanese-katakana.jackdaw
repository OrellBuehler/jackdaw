{
  "$schema": "https://raw.githubusercontent.com/OrellBuehler/jackdaw/main/format/jackdaw-pack.schema.json",
  "format": "jackdaw-pack",
  "version": 1,
  "id": "com.github.orellbuehler.jackdaw.examples.japanese-katakana",
  "title": "Japanese Katakana",
  "description": "All of katakana, row by row: the 46 basic characters, the 25 voiced ones and the 33 combined sounds, each asked both ways, character to reading and reading to character. Notes point out the look-alikes such as シ and ツ. At the end come the extra combinations used for foreign sounds, the long-vowel bar and sixteen loanwords to read.",
  "language": "ja",
  "author": "Jackdaw project",
  "license": "CC0-1.0",
  "source": "https://github.com/OrellBuehler/jackdaw",
  "tags": ["japanese", "katakana", "kana", "writing", "beginner"],
  "icon": "🗾",
  "color": "#1D4ED8",
  "revision": 1,
  "created": "2026-11-24",
  "updated": "2026-11-24",
  "sections": [
    {"id": "vowels", "title": "The five vowels"},
    {"id": "k-s", "title": "K and S rows"},
    {"id": "t-n", "title": "T and N rows"},
    {"id": "h-m", "title": "H and M rows"},
    {"id": "y-r-w", "title": "Y, R and W rows, and n"},
    {
      "id": "voiced",
      "title": "Voiced sounds",
      "description": "Two small strokes (dakuten) or a small circle (handakuten) change the consonant."
    },
    {
      "id": "combined",
      "title": "Combined sounds",
      "description": "A kana of the i column followed by a small ya, yu or yo is read as one syllable."
    },
    {"id": "combined-voiced", "title": "Combined sounds, voiced"},
    {
      "id": "extended",
      "title": "Foreign sounds",
      "description": "Combinations with a small vowel for sounds that Japanese words do not have."
    },
    {"id": "rules", "title": "Reading rules"},
    {"id": "words", "title": "First loanwords", "description": "Read the word, then check the reading and the meaning."}
  ],
  "study": {"order": "sequential", "newPerSession": 10, "reversible": true, "exercises": {"card": ["flip", "choice"]}},
  "items": [
    {"id": "a", "type": "card", "section": "vowels", "front": "ア", "back": "a"},
    {"id": "i", "type": "card", "section": "vowels", "front": "イ", "back": "i"},
    {
      "id": "u",
      "type": "card",
      "section": "vowels",
      "front": "ウ",
      "back": "u",
      "explanation": "ワ (*wa*) has the same shape without the short stroke on top."
    },
    {"id": "e", "type": "card", "section": "vowels", "front": "エ", "back": "e"},
    {"id": "o", "type": "card", "section": "vowels", "front": "オ", "back": "o"},
    {"id": "ka", "type": "card", "section": "k-s", "front": "カ", "back": "ka"},
    {"id": "ki", "type": "card", "section": "k-s", "front": "キ", "back": "ki"},
    {
      "id": "ku",
      "type": "card",
      "section": "k-s",
      "front": "ク",
      "back": "ku",
      "explanation": "タ (*ta*) has the same shape with one more short stroke inside."
    },
    {"id": "ke", "type": "card", "section": "k-s", "front": "ケ", "back": "ke"},
    {
      "id": "ko",
      "type": "card",
      "section": "k-s",
      "front": "コ",
      "back": "ko",
      "explanation": "In ユ (*yu*) the bottom line sticks out to the right. ヨ (*yo*) has three horizontal lines."
    },
    {"id": "sa", "type": "card", "section": "k-s", "front": "サ", "back": "sa"},
    {
      "id": "shi",
      "type": "card",
      "section": "k-s",
      "front": "シ",
      "back": "shi",
      "explanation": "Easily confused with ツ (*tsu*). In シ the two short strokes are stacked, and the long stroke rises from the bottom left. In ツ they sit side by side, and the long stroke falls from the top right."
    },
    {
      "id": "su",
      "type": "card",
      "section": "k-s",
      "front": "ス",
      "back": "su",
      "explanation": "In ヌ (*nu*) a short stroke crosses the long one."
    },
    {"id": "se", "type": "card", "section": "k-s", "front": "セ", "back": "se"},
    {
      "id": "so",
      "type": "card",
      "section": "k-s",
      "front": "ソ",
      "back": "so",
      "explanation": "Easily confused with ン (*n*). In ソ the long stroke falls from the top right. In ン it rises from the bottom left."
    },
    {"id": "ta", "type": "card", "section": "t-n", "front": "タ", "back": "ta"},
    {
      "id": "chi",
      "type": "card",
      "section": "t-n",
      "front": "チ",
      "back": "chi",
      "explanation": "The vertical stroke crosses the horizontal one. In テ (*te*) it starts below it."
    },
    {
      "id": "tsu",
      "type": "card",
      "section": "t-n",
      "front": "ツ",
      "back": "tsu",
      "explanation": "The short strokes sit side by side, and the long stroke falls from the top right. Compare シ (*shi*)."
    },
    {"id": "te", "type": "card", "section": "t-n", "front": "テ", "back": "te"},
    {"id": "to", "type": "card", "section": "t-n", "front": "ト", "back": "to"},
    {
      "id": "na",
      "type": "card",
      "section": "t-n",
      "front": "ナ",
      "back": "na",
      "explanation": "A cross with a straight horizontal stroke. メ (*me*) is made of two diagonal strokes."
    },
    {"id": "ni", "type": "card", "section": "t-n", "front": "ニ", "back": "ni"},
    {"id": "nu", "type": "card", "section": "t-n", "front": "ヌ", "back": "nu"},
    {"id": "ne", "type": "card", "section": "t-n", "front": "ネ", "back": "ne"},
    {"id": "no", "type": "card", "section": "t-n", "front": "ノ", "back": "no"},
    {"id": "ha", "type": "card", "section": "h-m", "front": "ハ", "back": "ha"},
    {"id": "hi", "type": "card", "section": "h-m", "front": "ヒ", "back": "hi"},
    {
      "id": "fu",
      "type": "card",
      "section": "h-m",
      "front": "フ",
      "back": "fu",
      "explanation": "The sound lies between *fu* and *hu*: the lips do not touch the teeth."
    },
    {"id": "he", "type": "card", "section": "h-m", "front": "ヘ", "back": "he", "explanation": "Almost identical to the hiragana へ."},
    {"id": "ho", "type": "card", "section": "h-m", "front": "ホ", "back": "ho"},
    {"id": "ma", "type": "card", "section": "h-m", "front": "マ", "back": "ma"},
    {"id": "mi", "type": "card", "section": "h-m", "front": "ミ", "back": "mi"},
    {"id": "mu", "type": "card", "section": "h-m", "front": "ム", "back": "mu"},
    {"id": "me", "type": "card", "section": "h-m", "front": "メ", "back": "me"},
    {"id": "mo", "type": "card", "section": "h-m", "front": "モ", "back": "mo"},
    {"id": "ya", "type": "card", "section": "y-r-w", "front": "ヤ", "back": "ya"},
    {"id": "yu", "type": "card", "section": "y-r-w", "front": "ユ", "back": "yu"},
    {"id": "yo", "type": "card", "section": "y-r-w", "front": "ヨ", "back": "yo"},
    {"id": "ra", "type": "card", "section": "y-r-w", "front": "ラ", "back": "ra"},
    {"id": "ri", "type": "card", "section": "y-r-w", "front": "リ", "back": "ri", "explanation": "Very similar to the hiragana り."},
    {
      "id": "ru",
      "type": "card",
      "section": "y-r-w",
      "front": "ル",
      "back": "ru",
      "explanation": "Two strokes. レ (*re*) is the right half alone."
    },
    {"id": "re", "type": "card", "section": "y-r-w", "front": "レ", "back": "re"},
    {"id": "ro", "type": "card", "section": "y-r-w", "front": "ロ", "back": "ro"},
    {"id": "wa", "type": "card", "section": "y-r-w", "front": "ワ", "back": "wa"},
    {
      "id": "wo",
      "type": "card",
      "section": "y-r-w",
      "front": "ヲ",
      "back": "wo",
      "explanation": "Pronounced *o*. Rare: the particle it stands for is normally written in hiragana (を)."
    },
    {
      "id": "n",
      "type": "card",
      "section": "y-r-w",
      "front": "ン",
      "back": "n",
      "explanation": "The long stroke rises from the bottom left. Compare ソ (*so*)."
    },
    {"id": "ga", "type": "card", "section": "voiced", "front": "ガ", "back": "ga"},
    {"id": "gi", "type": "card", "section": "voiced", "front": "ギ", "back": "gi"},
    {"id": "gu", "type": "card", "section": "voiced", "front": "グ", "back": "gu"},
    {"id": "ge", "type": "card", "section": "voiced", "front": "ゲ", "back": "ge"},
    {"id": "go", "type": "card", "section": "voiced", "front": "ゴ", "back": "go"},
    {"id": "za", "type": "card", "section": "voiced", "front": "ザ", "back": "za"},
    {"id": "ji", "type": "card", "section": "voiced", "front": "ジ", "back": "ji", "frontAlternatives": ["ヂ"]},
    {"id": "zu", "type": "card", "section": "voiced", "front": "ズ", "back": "zu", "frontAlternatives": ["ヅ"]},
    {"id": "ze", "type": "card", "section": "voiced", "front": "ゼ", "back": "ze"},
    {"id": "zo", "type": "card", "section": "voiced", "front": "ゾ", "back": "zo"},
    {"id": "da", "type": "card", "section": "voiced", "front": "ダ", "back": "da"},
    {
      "id": "dji",
      "type": "card",
      "section": "voiced",
      "front": "ヂ",
      "back": "ji",
      "reversible": false,
      "explanation": "Pronounced like ジ (*ji*), which is far more common."
    },
    {
      "id": "dzu",
      "type": "card",
      "section": "voiced",
      "front": "ヅ",
      "back": "zu",
      "reversible": false,
      "explanation": "Pronounced like ズ (*zu*), which is far more common."
    },
    {"id": "de", "type": "card", "section": "voiced", "front": "デ", "back": "de"},
    {"id": "do", "type": "card", "section": "voiced", "front": "ド", "back": "do"},
    {"id": "ba", "type": "card", "section": "voiced", "front": "バ", "back": "ba"},
    {"id": "bi", "type": "card", "section": "voiced", "front": "ビ", "back": "bi"},
    {"id": "bu", "type": "card", "section": "voiced", "front": "ブ", "back": "bu"},
    {"id": "be", "type": "card", "section": "voiced", "front": "ベ", "back": "be"},
    {"id": "bo", "type": "card", "section": "voiced", "front": "ボ", "back": "bo"},
    {"id": "pa", "type": "card", "section": "voiced", "front": "パ", "back": "pa"},
    {"id": "pi", "type": "card", "section": "voiced", "front": "ピ", "back": "pi"},
    {"id": "pu", "type": "card", "section": "voiced", "front": "プ", "back": "pu"},
    {"id": "pe", "type": "card", "section": "voiced", "front": "ペ", "back": "pe"},
    {"id": "po", "type": "card", "section": "voiced", "front": "ポ", "back": "po"},
    {"id": "kya", "type": "card", "section": "combined", "front": "キャ", "back": "kya"},
    {"id": "kyu", "type": "card", "section": "combined", "front": "キュ", "back": "kyu"},
    {"id": "kyo", "type": "card", "section": "combined", "front": "キョ", "back": "kyo"},
    {"id": "sha", "type": "card", "section": "combined", "front": "シャ", "back": "sha"},
    {"id": "shu", "type": "card", "section": "combined", "front": "シュ", "back": "shu"},
    {"id": "sho", "type": "card", "section": "combined", "front": "ショ", "back": "sho"},
    {"id": "cha", "type": "card", "section": "combined", "front": "チャ", "back": "cha"},
    {"id": "chu", "type": "card", "section": "combined", "front": "チュ", "back": "chu"},
    {"id": "cho", "type": "card", "section": "combined", "front": "チョ", "back": "cho"},
    {"id": "nya", "type": "card", "section": "combined", "front": "ニャ", "back": "nya"},
    {"id": "nyu", "type": "card", "section": "combined", "front": "ニュ", "back": "nyu"},
    {"id": "nyo", "type": "card", "section": "combined", "front": "ニョ", "back": "nyo"},
    {"id": "hya", "type": "card", "section": "combined", "front": "ヒャ", "back": "hya"},
    {"id": "hyu", "type": "card", "section": "combined", "front": "ヒュ", "back": "hyu"},
    {"id": "hyo", "type": "card", "section": "combined", "front": "ヒョ", "back": "hyo"},
    {"id": "mya", "type": "card", "section": "combined", "front": "ミャ", "back": "mya"},
    {"id": "myu", "type": "card", "section": "combined", "front": "ミュ", "back": "myu"},
    {"id": "myo", "type": "card", "section": "combined", "front": "ミョ", "back": "myo"},
    {"id": "rya", "type": "card", "section": "combined", "front": "リャ", "back": "rya"},
    {"id": "ryu", "type": "card", "section": "combined", "front": "リュ", "back": "ryu"},
    {"id": "ryo", "type": "card", "section": "combined", "front": "リョ", "back": "ryo"},
    {"id": "gya", "type": "card", "section": "combined-voiced", "front": "ギャ", "back": "gya"},
    {"id": "gyu", "type": "card", "section": "combined-voiced", "front": "ギュ", "back": "gyu"},
    {"id": "gyo", "type": "card", "section": "combined-voiced", "front": "ギョ", "back": "gyo"},
    {"id": "ja", "type": "card", "section": "combined-voiced", "front": "ジャ", "back": "ja"},
    {"id": "ju", "type": "card", "section": "combined-voiced", "front": "ジュ", "back": "ju"},
    {"id": "jo", "type": "card", "section": "combined-voiced", "front": "ジョ", "back": "jo"},
    {"id": "bya", "type": "card", "section": "combined-voiced", "front": "ビャ", "back": "bya"},
    {"id": "byu", "type": "card", "section": "combined-voiced", "front": "ビュ", "back": "byu"},
    {"id": "byo", "type": "card", "section": "combined-voiced", "front": "ビョ", "back": "byo"},
    {"id": "pya", "type": "card", "section": "combined-voiced", "front": "ピャ", "back": "pya"},
    {"id": "pyu", "type": "card", "section": "combined-voiced", "front": "ピュ", "back": "pyu"},
    {"id": "pyo", "type": "card", "section": "combined-voiced", "front": "ピョ", "back": "pyo"},
    {"id": "ext-fa", "type": "card", "section": "extended", "front": "ファ", "back": "fa", "explanation": "As in ファン (*fan*, fan)."},
    {"id": "ext-fi", "type": "card", "section": "extended", "front": "フィ", "back": "fi", "explanation": "As in フィルム (*firumu*, film)."},
    {"id": "ext-fe", "type": "card", "section": "extended", "front": "フェ", "back": "fe", "explanation": "As in カフェ (*kafe*, café)."},
    {"id": "ext-fo", "type": "card", "section": "extended", "front": "フォ", "back": "fo", "explanation": "As in フォーク (*fōku*, fork)."},
    {"id": "ext-ti", "type": "card", "section": "extended", "front": "ティ", "back": "ti", "explanation": "As in パーティー (*pātī*, party)."},
    {"id": "ext-di", "type": "card", "section": "extended", "front": "ディ", "back": "di", "explanation": "As in ディスク (*disuku*, disc)."},
    {"id": "ext-wi", "type": "card", "section": "extended", "front": "ウィ", "back": "wi", "explanation": "As in ウィーン (*Wīn*, Vienna)."},
    {"id": "ext-we", "type": "card", "section": "extended", "front": "ウェ", "back": "we", "explanation": "As in ウェブ (*webu*, web)."},
    {"id": "ext-she", "type": "card", "section": "extended", "front": "シェ", "back": "she", "explanation": "As in シェフ (*shefu*, chef)."},
    {"id": "ext-je", "type": "card", "section": "extended", "front": "ジェ", "back": "je", "explanation": "As in ジェット (*jetto*, jet)."},
    {"id": "ext-che", "type": "card", "section": "extended", "front": "チェ", "back": "che", "explanation": "As in チェス (*chesu*, chess)."},
    {
      "id": "ext-vu",
      "type": "card",
      "section": "extended",
      "front": "ヴ",
      "back": "vu",
      "explanation": "As in ヴァイオリン (*vaiorin*, violin), where a small ァ turns it into *va*."
    },
    {
      "id": "rule-scripts",
      "type": "choice",
      "section": "rules",
      "question": "What is katakana mainly used for?",
      "options": [
        {"text": "Loanwords, foreign names and sound words", "correct": true},
        {"text": "Word endings and particles", "explanation": "That is the job of hiragana."},
        {"text": "Words of Chinese origin", "explanation": "Those are usually written in kanji."},
        {"text": "Formal and official texts"}
      ]
    },
    {
      "id": "rule-long-vowel",
      "type": "choice",
      "section": "rules",
      "question": "How does katakana mark a long vowel, as in the word for coffee, *kōhī*?",
      "options": [
        {"text": "With a bar after the kana: コーヒー", "correct": true},
        {"text": "With ウ after the kana: コウヒイ", "explanation": "Adding a vowel kana is how hiragana does it."},
        {"text": "With a small ッ: コッヒッ", "explanation": "The small ッ doubles a consonant."},
        {"text": "By writing the kana twice: ココヒヒ"}
      ],
      "explanation": "In vertical writing the bar is vertical too."
    },
    {
      "id": "rule-small-tsu",
      "type": "choice",
      "section": "rules",
      "question": "What does a small ッ do, as in ベッド?",
      "options": [
        {"text": "It doubles the consonant that follows: *beddo*", "correct": true},
        {"text": "It is read *tsu* as usual: *betsudo*"},
        {"text": "It lengthens the vowel before it: *bēdo*"},
        {"text": "It is silent: *bedo*"}
      ],
      "explanation": "ベッド means *bed*."
    },
    {
      "id": "rule-final-consonant",
      "type": "choice",
      "section": "rules",
      "question": "Japanese syllables end in a vowel or in *n*. How does the English word *bus* become katakana?",
      "options": [
        {"text": "バス (*basu*)", "correct": true, "explanation": "A *u* is added after most final consonants."},
        {"text": "バシ (*bashi*)"},
        {"text": "バソ (*baso*)", "explanation": "An *o* is added after *t* and *d*, as in ベッド (*beddo*)."},
        {"text": "バサ (*basa*)"}
      ]
    },
    {
      "id": "rule-shi-tsu",
      "type": "truefalse",
      "section": "rules",
      "statement": "In シ (*shi*) the long stroke rises from the bottom left.",
      "answer": true,
      "explanation": "In ツ (*tsu*) it falls from the top right. ン (*n*) behaves like シ, and ソ (*so*) like ツ."
    },
    {
      "id": "rule-v",
      "type": "text",
      "section": "rules",
      "question": "Which consonant does ヴ, a ウ with two small strokes, stand for?",
      "answers": ["v"],
      "explanation": "Many speakers pronounce it as *b*, and words with *v* are often written with the B row instead: バイオリン for *violin*."
    },
    {
      "id": "word-pan",
      "type": "card",
      "section": "words",
      "front": "パン",
      "back": "pan (bread)",
      "reversible": false,
      "explanation": "From the Portuguese *pão*."
    },
    {"id": "word-basu", "type": "card", "section": "words", "front": "バス", "back": "basu (bus)", "reversible": false},
    {"id": "word-kamera", "type": "card", "section": "words", "front": "カメラ", "back": "kamera (camera)", "reversible": false},
    {"id": "word-terebi", "type": "card", "section": "words", "front": "テレビ", "back": "terebi (television)", "reversible": false},
    {"id": "word-hoteru", "type": "card", "section": "words", "front": "ホテル", "back": "hoteru (hotel)", "reversible": false},
    {"id": "word-suisu", "type": "card", "section": "words", "front": "スイス", "back": "Suisu (Switzerland)", "reversible": false},
    {
      "id": "word-doitsu",
      "type": "card",
      "section": "words",
      "front": "ドイツ",
      "back": "Doitsu (Germany)",
      "reversible": false,
