    {"id": "word-resutoran", "type": "card", "section": "words", "front": "レストラン", "back": "resutoran (restaurant)", "reversible": false},
    {
      "id": "word-kohi",
      "type": "card",
      "section": "words",
      "front": "コーヒー",
      "back": "kōhī (coffee)",
      "reversible": false,
      "explanation": "The bar ー lengthens the vowel before it."
    },
    {"id": "word-biru", "type": "card", "section": "words", "front": "ビール", "back": "bīru (beer)", "reversible": false},
    {"id": "word-takushi", "type": "card", "section": "words", "front": "タクシー", "back": "takushī (taxi)", "reversible": false},
    {"id": "word-chokoreto", "type": "card", "section": "words", "front": "チョコレート", "back": "chokorēto (chocolate)", "reversible": false},
    {
      "id": "word-aisukurimu",
      "type": "card",
      "section": "words",
      "front": "アイスクリーム",
      "back": "aisukurīmu (ice cream)",
      "reversible": false
    },
    {"id": "word-konpyuta", "type": "card", "section": "words", "front": "コンピューター", "back": "konpyūtā (computer)", "reversible": false},
    {"id": "word-intanetto", "type": "card", "section": "words", "front": "インターネット", "back": "intānetto (internet)", "reversible": false}
  ]
}
