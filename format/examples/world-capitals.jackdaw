  "version": 1,
  "id": "com.github.orellbuehler.jackdaw.examples.world-capitals",
  "title": "World Capitals",
  "description": "The capitals of the 149 countries of Africa, Asia, the Americas and Oceania, region by region, with notes on the ones that are easy to get wrong: moved capitals, shared capitals and cities that are not the largest. It follows on from European Capitals. Cards are asked as multiple choice and as typed answers, and local spellings are accepted.",
  "language": "en",
  "author": "Jackdaw project",
  "license": "CC0-1.0",
  "source": "https://github.com/OrellBuehler/jackdaw",
  "tags": ["geography", "capitals", "world", "africa", "asia", "americas", "oceania"],
  "icon": "🌐",
  "color": "#0F766E",
  "revision": 1,
  "created": "2026-11-24",
  "updated": "2026-11-24",
  "sections": [
    {"id": "north-america", "title": "North and Central America"},
    {"id": "caribbean", "title": "The Caribbean"},
    {"id": "south-america", "title": "South America"},
    {"id": "north-africa", "title": "North Africa"},
    {"id": "west-africa", "title": "West Africa"},
    {"id": "central-africa", "title": "Central Africa"},
    {"id": "east-africa", "title": "East Africa"},
    {"id": "southern-africa", "title": "Southern Africa"},
    {"id": "middle-east", "title": "The Middle East and the Caucasus"},
    {"id": "central-south-asia", "title": "Central and South Asia"},
    {"id": "east-asia", "title": "East and Southeast Asia"},
    {"id": "oceania", "title": "Oceania"},
    {"id": "facts", "title": "Beyond the list", "description": "Moved capitals, shared capitals and a little sorting."}
  ],
  "study": {"order": "sequential", "newPerSession": 8, "ignoreDiacritics": true, "exercises": {"card": ["choice", "type"]}},
  "items": [
    {
      "id": "capital-canada",
      "type": "card",
      "section": "north-america",
      "front": "Capital of **Canada**?",
      "back": "Ottawa",
      "explanation": "Not Toronto or Montreal: Queen Victoria chose Ottawa in 1857, on the border between English- and French-speaking Canada."
    },
    {
      "id": "capital-united-states",
