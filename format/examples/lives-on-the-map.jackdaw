  "id": "com.github.orellbuehler.jackdaw.examples.lives-on-the-map",
  "title": "Lives on the Map",
  "description": "123 famous people, from Alexander the Great to Pelé, known by two places only: where they were born and where they died. A line on the map joins the two, labelled with the years; name the person. Rulers, leaders, scientists, writers and artists, as multiple choice, flip cards and typed answers.",
  "language": "en",
  "author": "Jackdaw project",
  "license": "CC0-1.0",
  "source": "https://www.wikidata.org",
  "tags": [
    "history",
    "geography",
    "maps",
    "people",
    "biography"
  ],
  "icon": "🧭",
  "color": "#6D28D9",
  "revision": 1,
  "created": "2026-11-25",
  "updated": "2026-11-25",
  "sections": [
    {
      "id": "rulers",
      "title": "Rulers and conquerors",
      "description": "Emperors, kings and sultans, from Alexander to Elizabeth II."
    },
    {
      "id": "leaders",
      "title": "Statesmen, rebels and reformers",
      "description": "Presidents, revolutionaries and moral leaders."
    },
    {
      "id": "science",
      "title": "Scientists, thinkers and explorers",
      "description": "Astronomers, inventors, philosophers and navigators."
    },
    {
      "id": "writers",
      "title": "Writers",
      "description": "Poets, novelists and playwrights."
    },
    {
      "id": "arts",
      "title": "Artists, composers and entertainers",
      "description": "Painters, musicians, film stars and athletes."
    }
  ],
  "study": {
    "order": "sequential",
    "newPerSession": 8,
    "ignoreDiacritics": true,
    "exercises": {
      "card": [
        "flip",
        "choice",
        "type"
      ]
    }
  },
