{
  "$schema": "https://raw.githubusercontent.com/OrellBuehler/jackdaw/main/format/jackdaw-pack.schema.json",
  "format": "jackdaw-pack",
  "version": 2,
  "id": "com.github.orellbuehler.jackdaw.examples.flags-of-the-world",
  "title": "Flags of the World",
  "description": "The national flags of 149 countries, region by region: you see the flag and name the country, as multiple choice or typed. Notes point out the look-alikes, from Romania and Chad to Indonesia and Monaco, and a short quiz on flag facts follows. The flags with very detailed coats of arms, such as those of Spain and Mexico, are not included. The drawings are public-domain files from Wikimedia Commons.",
  "language": "en",
  "author": "Jackdaw project",
  "license": "CC0-1.0",
  "source": "https://github.com/OrellBuehler/jackdaw",
  "tags": ["geography", "flags", "countries", "world"],
  "icon": "🏳️",
  "color": "#B45309",
  "revision": 1,
  "created": "2026-11-24",
  "updated": "2026-11-24",
  "sections": [
    {"id": "europe-west", "title": "Western and Northern Europe"},
    {"id": "europe-east", "title": "Central, Eastern and Southern Europe"},
    {"id": "middle-east", "title": "The Middle East and the Caucasus"},
    {"id": "asia", "title": "Central, South and East Asia"},
    {"id": "southeast-asia", "title": "Southeast Asia"},
    {"id": "north-west-africa", "title": "North and West Africa"},
    {"id": "central-east-africa", "title": "Central and East Africa"},
    {"id": "southern-africa", "title": "Southern Africa and the Indian Ocean"},
    {"id": "north-america", "title": "North America and the Caribbean"},
    {"id": "south-america", "title": "South America"},
    {"id": "oceania", "title": "Oceania"},
    {"id": "facts", "title": "Flag facts", "description": "Look-alikes, shapes and what the symbols stand for."}
  ],
  "study": {"order": "sequential", "newPerSession": 8, "ignoreDiacritics": true},
  "items": [
    {
      "id": "flag-france",
      "type": "card",
      "section": "europe-west",
      "front": "Which country's flag is this?",
      "back": "France",
      "explanation": "The *Tricolore*. Blue is at the hoist, the side next to the pole.",
      "figure": {
        "alt": "Three vertical stripes: blue, white, red.",
        "svg": "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 3 2'><path fill='#EC1920' d='M0 0h3v2H0z'/><path fill='#fff' d='M0 0h2v2H0z'/><path fill='#051440' d='M0 0h1v2H0z'/><path d='M0 0h3v2h-3z' fill='none' stroke='currentColor' stroke-opacity='.35' stroke-width='0.02'/></svg>"
      }
    },
